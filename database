// ==========================================
// AREA 1: MATRICE DELLE COMPETENZE (Blu)
// ==========================================

Table competency [headercolor: #2980B9] {
  id integer [pk]
  title varchar(255) [not null]
  weight integer [not null]

  Note: '''Rappresenta le macro-competenze (es. "Definire l'idea progettuale") e il loro peso (da 1 a 5).'''
}

Table subcompetency [headercolor: #2980B9] {
  id integer [pk]
  title varchar(255) [not null]
  weight integer [not null]
  input text
  output text
  action text
  competency_id integer [not null]

  Note: '''Le capacità specifiche che compongono una competenza. Definisce l'input testuale, l'azione da svolgere e l'output atteso.'''
}
Ref: subcompetency.competency_id > competency.id

Table tool [headercolor: #2980B9] {
  id integer [pk]
  name varchar(255) [not null]

  Note: '''Elenco degli strumenti (tools) utilizzabili durante la sotto-competenza.'''
}

Table tool_subcompetency [headercolor: #2980B9] {
  tool_id integer [not null]
  subcompetency_id integer [not null]

  Note: '''Tabella di collegamento N:N tra strumenti e sotto-competenze.'''
}
Ref: tool_subcompetency.tool_id > tool.id
Ref: tool_subcompetency.subcompetency_id > subcompetency.id

Table method [headercolor: #2980B9] {
  id integer [pk]
  name varchar(255) [not null]

  Note: '''Elenco dei metodi applicabili per una determinata sotto-competenza.'''
}

Table method_subcompetency [headercolor: #2980B9] {
  method_id integer [not null]
  subcompetency_id integer [not null]

  Note: '''Tabella di collegamento N:N tra metodi e sotto-competenze.'''
}
Ref: method_subcompetency.subcompetency_id > subcompetency.id
Ref: method_subcompetency.method_id > method.id

Table skill [headercolor: #2980B9] {
  id integer [pk]
  name varchar(255) [not null]

  Note: '''Elenco delle conoscenze (skills) richieste per affrontare la sotto-competenza.'''
}

Table skill_subcompetency [headercolor: #2980B9] {
  skill_id integer [not null]
  subcompetency_id integer [not null]

  Note: '''Tabella di collegamento N:N tra skills e sotto-competenze.'''
}
Ref: skill_subcompetency.skill_id > skill.id
Ref: skill_subcompetency.subcompetency_id > subcompetency.id

// ==========================================
// AREA 2: MODELLO DI VALUTAZIONE (Verde)
// ==========================================

Table observation_object [headercolor: #16A085] {
  id integer [pk]
  description text
  subcompetency_id integer [not null, unique]

  Note: '''L'oggetto concreto che viene valutato (es. "Documento di sintesi"). Ha una relazione 1 a 1 con la sotto-competenza.'''
}
Ref: observation_object.subcompetency_id - subcompetency.id

Table indicator [headercolor: #16A085] {
  id integer [pk]
  description text [not null]
  weight integer [not null]
  rubric_set_id integer [not null]
  observation_object_id integer [not null]

  Note: '''Le diverse prospettive di valutazione dell'oggetto di osservazione. Ogni indicatore ha un proprio peso (da 1 a 5).'''
}
Ref: indicator.observation_object_id > observation_object.id
Ref: indicator.rubric_set_id > rubric_set.id

Table rubric_set [headercolor: #16A085] {
  id integer [pk]
  yes_no boolean [not null]

  Note: '''Identifica il tipo di valutazione: standard (5 livelli) o binario (Yes/No).'''
}

Table rubric_level [headercolor: #16A085] {
  id integer [pk]
  description varchar(255) [not null]
  rank integer [not null]
  rubric_set_id integer [not null]

  Note: '''I singoli livelli di giudizio (es. 1 = Inadeguato, 5 = Eccellente) che i valutatori possono assegnare a un indicatore.'''
}
Ref: rubric_level.rubric_set_id > rubric_set.id

// ==========================================
// AREA 3: PROGETTAZIONE TEST (Arancione)
// ==========================================

Table test_designer [headercolor: #D35400] {
  id integer [pk]
  user_id integer [not null]

  Note: '''Anagrafica e ruolo dell'utente che progetta il test.'''
}

Table test [headercolor: #D35400] {
  id integer [pk]
  assessment_situation text [not null]
  test_designer_id integer [not null]

  Note: '''Il test vero e proprio. Contiene l'assessment situation (descrizione del contesto, luogo, tempo, materiale, ecc.).'''
}
Ref: test.test_designer_id > test_designer.id

Table test_subcompetency [headercolor: #D35400] {
  test_id integer [not null]
  subcompetency_id integer [not null]

  Note: '''Tabella N:N che associa quali sotto-competenze vengono valutate in uno specifico test.'''
}
Ref: test_subcompetency.test_id > test.id
Ref: test_subcompetency.subcompetency_id > subcompetency.id

// ==========================================
// AREA 4: ESECUZIONE TEST (Viola)
// ==========================================

Table evaluated_user [headercolor: #8E44AD] {
  id integer [pk]
  user_id integer [not null]

  Note: '''Anagrafica e ruolo dell'utente che deve essere valutato (svolge il test).'''
}

Table test_execution [headercolor: #8E44AD] {
  id integer [pk]
  test_id integer [not null]
  user_id integer [not null]
  test_score numeric
  max_score numeric

  Note: '''L'istanza vera e propria di un test svolto da un utente. Salva i punteggi aggregati (ottenuto e massimo raggiungibile).'''
}
Ref: test_execution.test_id > test.id
Ref: test_execution.user_id > evaluated_user.id

Table test_output [headercolor: #8E44AD] {
  id integer [pk]
  name varchar(255) [not null]
  description text
  url varchar(255)
  test_execution_id integer [not null]
  version varchar(255)

  Note: '''Eventuali materiali digitali (documenti, video, foto) prodotti dall'utente valutato durante l'esecuzione del test.'''
}
Ref: test_output.test_execution_id > test_execution.id

// ==========================================
// AREA 5: VALUTAZIONE E RISULTATI (Rosso)
// ==========================================

Table test_evaluator [headercolor: #C0392B] {
  id integer [pk]
  user_id integer [not null]

  Note: '''Anagrafica e ruolo dell'utente incaricato di valutare il test.'''
}

Table test_evaluator_test [headercolor: #C0392B] {
  test_evaluator_id integer [not null]
  test_id integer [not null]

  Note: '''Tabella N:N che assegna uno o più valutatori a uno specifico test.'''
}
Ref: test_evaluator_test.test_evaluator_id > test_evaluator.id
Ref: test_evaluator_test.test_id > test.id

Table rubric_level_assignment [headercolor: #C0392B] {
  id integer [pk]
  rubric_rank integer [not null]
  indicator_id integer [not null]
  test_execution_id integer [not null]
  evaluator_id integer [not null]

  Note: '''Il punteggio effettivo (rubric_rank) assegnato da un valutatore a un singolo indicatore durante una specifica esecuzione del test.'''
}
Ref: rubric_level_assignment.indicator_id > indicator.id
Ref: rubric_level_assignment.evaluator_id > test_evaluator.id
Ref: rubric_level_assignment.test_execution_id > test_execution.id

Table best_subcompetency_score [headercolor: #C0392B] {
  id integer [pk]
  best_score_absolute integer [not null]
  best_score_percentage numeric [not null]
  user_id integer [not null]
  subcompetency_id integer [not null]

  Note: '''Storicizzazione del miglior punteggio (assoluto e in percentuale) ottenuto da un utente per una singola sotto-competenza.'''
}
Ref: best_subcompetency_score.user_id > evaluated_user.id
Ref: best_subcompetency_score.subcompetency_id > subcompetency.id

Table best_competency_score [headercolor: #C0392B] {
  id integer [pk]
  best_score_absolute integer [not null]
  best_score_percentage numeric [not null]
  user_id integer [not null]
  competency_id integer [not null]

  Note: '''Storicizzazione del miglior punteggio (assoluto e in percentuale) ottenuto da un utente per un'intera competenza (somma delle sotto-competenze).'''
}
Ref: best_competency_score.user_id > evaluated_user.id
Ref: best_competency_score.competency_id > competency.id

// ==========================================
// RAGGRUPPAMENTI VISIVI (TableGroups)
// ==========================================
TableGroup "Matrice delle Competenze" {
  competency
  subcompetency
  tool
  tool_subcompetency
  method
  method_subcompetency
  skill
  skill_subcompetency
}

TableGroup "Modello di Valutazione" {
  observation_object
  indicator
  rubric_set
  rubric_level
}

TableGroup "Progettazione Test" {
  test
  test_designer
  test_subcompetency
}

TableGroup "Esecuzione Test" {
  evaluated_user
  test_execution
  test_output
}

TableGroup "Valutazione e Risultati" {
  test_evaluator
  test_evaluator_test
  rubric_level_assignment
  best_subcompetency_score
  best_competency_score
}
